# Copy this file to .env for local overrides (optional -- defaults work out of the box).
# On Railway, set these under your service's "Variables" tab instead of using a file.

SECRET_KEY=change-this-to-a-long-random-string-in-production
DEBUG=False
ALLOWED_HOSTS=thebestcryptocourse.com,www.thebestcryptocourse.com
SITE_NAME=TheBestCryptoCourse

# Railway sets DATABASE_URL automatically once you attach a Postgres database.
# You don't need to set it by hand.
